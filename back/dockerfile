FROM python:3.11-slim

# Install system dependencies for WeasyPrint
RUN apt-get update && apt-get install -y \
    gcc \
    ffmpeg \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libharfbuzz0b \
    libcairo2 \
    libffi-dev \
    libgdk-pixbuf-2.0-0 \
    shared-mime-info \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Herramientas de descarga de modelos Vosk
RUN apt-get update && apt-get install -y --no-install-recommends wget unzip && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir -p /opt/vosk-models

# Modelo grande de español (~1.4 GB, capa propia para no re-descargarlo)
RUN wget -q -O /tmp/es.zip https://alphacephei.com/vosk/models/vosk-model-es-0.42.zip && \
    unzip -q /tmp/es.zip -d /opt/vosk-models/ && \
    rm /tmp/es.zip && \
    test -d /opt/vosk-models/vosk-model-es-0.42

# Modelo de hablante (x-vectors para diarización)
RUN wget -q -O /tmp/spk.zip https://alphacephei.com/vosk/models/vosk-model-spk-0.4.zip && \
    unzip -q /tmp/spk.zip -d /opt/vosk-models/ && \
    rm /tmp/spk.zip && \
    test -d /opt/vosk-models/vosk-model-spk-0.4

COPY requirements.txt .
RUN pip install -r requirements.txt

COPY . .

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]