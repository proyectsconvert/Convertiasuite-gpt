FROM python:3.11-slim

# Install system dependencies for WeasyPrint
RUN apt-get update && apt-get install -y \
    gcc \
    ffmpeg \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libharfbuzz0b \
    libcairo2 \
    libffi-dev \
    libgdk-pixbuf-2.0-0 \
    shared-mime-info \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Download full/heavy Vosk Spanish model (~1.4GB, cached layer)
RUN mkdir -p /opt/vosk-models && \
    apt-get update && apt-get install -y --no-install-recommends wget unzip && \
    wget -q --show-progress -O /tmp/vosk-model-es-0.42.zip \
      https://alphacephei.com/vosk/models/vosk-model-small-es-0.42.zip && \
    unzip -q /tmp/vosk-model-es-0.42.zip -d /opt/vosk-models/ && \
    rm /tmp/vosk-model-es-0.42.zip && \
    apt-get purge -y wget unzip && apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install -r requirements.txt

COPY . .

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]